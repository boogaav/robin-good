# ---- network ---------------------------------------------------------------
# The public RPC works but is rate-limited ("not recommended for production").
# Recommended: free Alchemy account -> create a Robinhood Chain app -> use:
#RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# ---- HARD CAPS (the learning loop can NEVER exceed these) -------------------
MAX_TRADE_ETH=0.02
MAX_OPEN_POSITIONS=3
MAX_DAILY_SPEND_ETH=0.1
MAX_DAILY_LOSS_ETH=0.05
MAX_SLIPPAGE_PCT=3
MIN_WALLET_RESERVE_ETH=0.01

# ---- going live ------------------------------------------------------------
# All three must be set or the agent stays in DRY_RUN (simulated fills).
# Use a FRESH burner wallet funded only with what you can afford to lose.
#LIVE=1
#ARM_LIVE=I-UNDERSTAND-THE-RISKS
#PRIVATE_KEY=0xyour_burner_wallet_private_key

# ---- tuning ----------------------------------------------------------------
POLL_MS=5000
